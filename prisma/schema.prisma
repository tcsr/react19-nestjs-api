// Prisma schema — single source of truth for the DB shape + generated client.
// Demonstrates the core relationship types (1-1, 1-many, many-many).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL comes from prisma7.config.ts (datasource.url = env DATABASE_URL).
}

// User 1—1 Profile, User 1—many Post.
model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  name    String
  profile Profile? // 1-1 (optional side)
  posts   Post[]   // 1-many
}

// 1—1 with User: the FK + @unique lives on the owning side.
model Profile {
  id     Int    @id @default(autoincrement())
  bio    String
  userId Int    @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// Post — mirrors the frontend `Post` type in react19-topics/src/lib/api.ts.
// 1—many with User (author), 1—many with Comment, many—many with Category.
model Post {
  id         Int        @id @default(autoincrement())
  title      String
  body       String
  userId     Int        @map("user_id")
  author     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]  // 1-many
  categories Category[] // many-many (implicit join table)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([userId]) // FK index — speeds author lookups/joins
  @@map("posts")
}

// 1—many with Post.
model Comment {
  id     Int    @id @default(autoincrement())
  text   String
  postId Int    @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

// many—many with Post (Prisma manages the implicit join table).
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]

  @@map("categories")
}
